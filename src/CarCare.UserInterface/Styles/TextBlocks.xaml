<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <Style x:Key="HeadingSmall" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Colour}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="8" />
    </Style>
    
    <Style x:Key="HeadingMedium" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Colour}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Margin" Value="8" />
    </Style>

    <Style x:Key="Paragraph" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Colour}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0, 8, 0, 0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Justify" />
    </Style>

    <Style x:Key="InputControlHeading" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Shared.Accent}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style x:Key="Default" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Colour}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2" />
    </Style>

    <Style x:Key="Error" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Error.Colour}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Left" />
    </Style>

    <Style x:Key="Log" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Text.Colour}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontFamily" Value="Cascadia Code" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</ResourceDictionary>