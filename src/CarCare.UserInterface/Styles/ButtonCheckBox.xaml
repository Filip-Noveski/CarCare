<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="CheckBox.Checked.Background" Color="#22AAAAAA"/>
    <SolidColorBrush x:Key="CheckBox.Intermediate.Background" Color="#10AAAAAA"/>
    <Style x:Key="ButtonCheckBox" TargetType="{x:Type CheckBox}">
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="templateRoot" Background="Transparent" SnapsToDevicePixels="True"
                            BorderThickness="1" BorderBrush="{DynamicResource Control.Border}"
                            Padding="2" Margin="0,0,-1,0">

                        <ContentPresenter x:Name="contentPresenter" Focusable="False"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" 
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Background" TargetName="templateRoot" 
                                    Value="{DynamicResource Control.Hover.Background}"/>
                            <Setter Property="BorderBrush" TargetName="templateRoot" 
                                    Value="{DynamicResource Control.Hover.Border}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter Property="Opacity" TargetName="templateRoot" 
                                    Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter Property="Background" TargetName="templateRoot" 
                                    Value="{DynamicResource Control.Pressed.Background}"/>
                            <Setter Property="BorderBrush" TargetName="templateRoot" 
                                    Value="{DynamicResource Control.Pressed.Border}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter Property="Background" TargetName="templateRoot" 
                                    Value="{DynamicResource CheckBox.Checked.Background}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Background" TargetName="templateRoot" 
                                    Value="{DynamicResource CheckBox.Intermediate.Background}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>