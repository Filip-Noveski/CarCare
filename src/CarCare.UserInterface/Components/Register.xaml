<UserControl x:Class="CarCare.UserInterface.Components.Register"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components" 
             xmlns:converters="clr-namespace:CarCare.Processing.Converters;assembly=CarCare.Processing" 
             xmlns:controls="clr-namespace:CarCare.UserInterface.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="275" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:AuthenticationArgsConverter x:Key="AuthenticationArgsConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.4*" />
            <ColumnDefinition Width="0.6*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Grid.Column="0" VerticalAlignment="Top">
            <Button Style="{StaticResource IconButton}" Command="{Binding NavigateToLoginCommand}" 
                    Width="40" Height="30"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                <Path Width="30" Height="20" Stroke="{DynamicResource Shared.Accent}" StrokeThickness="2"
                      Data="M5,10 L25,10 M10,5L5,10L10,15" />
            </Button>

            <Ellipse Grid.Row="2" Grid.Column="1" Width="80" Height="80" Margin="6">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>

            <Button Grid.Row="2" Grid.Column="0"
                    Width="110" Height="45" Command="{Binding ChooseAvatarCommand}"
                    Margin="6">
                <TextBlock TextWrapping="Wrap" TextAlignment="Center">Add Custom Avatar</TextBlock>
            </Button>
        </StackPanel>

        <Grid Grid.Column="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Top">
                <controls:TextBoxControl Heading="Username" Text="{Binding Username, Mode=TwoWay}" Margin="6" />
                <controls:PasswordBoxControl x:Name="PasswordBox" Heading="Password" Margin="6" />
            </StackPanel>
            
            <StackPanel Orientation="Vertical" Margin="6" VerticalAlignment="Bottom">
                <TextBlock Style="{StaticResource Error}" Text="{Binding Error}" Margin="6"/>

                <Button Content="Register" Command="{Binding RegisterCommand}"
                        Width="80" Height="30" Margin="6">
                    <Button.CommandParameter>
                        <MultiBinding Converter="{StaticResource AuthenticationArgsConverter}">
                            <Binding RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                            <Binding Path="InnerPasswordBox" ElementName="PasswordBox"/>
                        </MultiBinding>
                    </Button.CommandParameter>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
