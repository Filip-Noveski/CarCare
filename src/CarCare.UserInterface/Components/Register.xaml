<UserControl x:Class="CarCare.UserInterface.Components.Register"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components" xmlns:converters="clr-namespace:CarCare.Processing.Converters;assembly=CarCare.Processing"
             mc:Ignorable="d" 
             d:DesignHeight="275" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:AuthenticationArgsConverter x:Key="AuthenticationArgsConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.2*" />
            <RowDefinition Height="0.2*" />
            <RowDefinition Height="0.35*" />
            <RowDefinition Height="0.25*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.35*" />
            <ColumnDefinition Width="0.65*" />
        </Grid.ColumnDefinitions>

        <Button Command="{Binding NavigateToLoginCommand}" Width="30" Height="20"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            ←
        </Button>
        <TextBlock Text="Username:" Grid.Row="0" Grid.Column="0"
                   VerticalAlignment="Center" TextAlignment="Right"/>
        <TextBlock Text="Password:" Grid.Row="1" Grid.Column="0"
                   VerticalAlignment="Center" TextAlignment="Right"/>
        <Button Content="Add Custom Avatar" Grid.Row="2" Grid.Column="0"
                Width="120" Height="20" Command="{Binding ChooseAvatarCommand}"/>

        <TextBox Text="{Binding Username}" Grid.Row="0" Grid.Column="1"
                 Width="160" Height="20"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="1" Grid.Column="1"
                     Width="160" Height="20"/>
        <Ellipse Grid.Row="2" Grid.Column="1" Width="80" Height="80">
            <Ellipse.Fill>
                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
            </Ellipse.Fill>
        </Ellipse>

        <StackPanel Orientation="Vertical" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="{Binding Error}" Margin="6"/>

            <Button Content="Register" Command="{Binding RegisterCommand}"
                    Width="60" Height="20">
                <Button.CommandParameter>
                    <MultiBinding Converter="{StaticResource AuthenticationArgsConverter}">
                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                        <Binding ElementName="PasswordBox"/>
                    </MultiBinding>
                </Button.CommandParameter>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
