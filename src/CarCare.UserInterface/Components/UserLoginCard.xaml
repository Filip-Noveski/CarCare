<UserControl x:Class="CarCare.UserInterface.Components.UserLoginCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components"
             mc:Ignorable="d" 
             d:DesignHeight="114" d:DesignWidth="96">
    <Border PreviewMouseLeftButtonUp="SelectUser">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Pane.Border}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="6"/>
                <Setter Property="Background" Value="{DynamicResource Card.Background}"/>
                <Setter Property="Cursor" Value="Hand"/>

                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Card.Hover.Background}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        
        <StackPanel Orientation="Vertical">
            <Ellipse Width="60" Height="60">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock Style="{StaticResource HeadingSmall}" Text="{Binding Username}"
                       TextWrapping="Wrap" TextAlignment="Center" Width="60" />
        </StackPanel>
    </Border>
</UserControl>
