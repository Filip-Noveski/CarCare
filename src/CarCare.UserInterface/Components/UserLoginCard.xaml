<UserControl x:Class="CarCare.UserInterface.Components.UserLoginCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components"
             mc:Ignorable="d" 
             d:DesignHeight="114" d:DesignWidth="96">
    <Border BorderBrush="Black" BorderThickness="1"
            CornerRadius="6" PreviewMouseLeftButtonUp="SelectUser"
            Padding="12" Margin="6">
        <StackPanel Orientation="Vertical">
            <Ellipse Width="60" Height="60">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                </Ellipse.Fill>
            </Ellipse>
            <TextBlock Text="{Binding Username}" />
        </StackPanel>
    </Border>
</UserControl>
