<UserControl x:Class="CarCare.UserInterface.Components.SessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">
    <Canvas>
        <Grid Width="36" Height="36" Canvas.Right="0" Canvas.Top="0">
            <Grid.Resources>
                <SolidColorBrush x:Key="HoverBrush" Color="Transparent"/>
            </Grid.Resources>
            
            <Ellipse Width="36" Height="36" Visibility="{Binding MenuVisibility}"
                     Canvas.Right="0" Canvas.Top="0" Fill="#CCCCCC"/>

            <Ellipse x:Name="AvatarSurroundHover" Width="36" Height="36"
                     Fill="{StaticResource HoverBrush}"/>

            <Ellipse x:Name="AvatarImage" Width="30" Height="30">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding User.Avatar}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <Button Visibility="Visible" Width="30" Height="30"
                    Canvas.Right="3" Canvas.Top="3"
                    Command="{Binding ToggleMenuCommand}"
                    Opacity="0">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="AvatarSurroundHover"
                            Storyboard.TargetProperty="Fill.Color"
                            To="#AAAAAA" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="AvatarSurroundHover"
                            Storyboard.TargetProperty="Fill.Color"
                            To="Transparent" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <StackPanel Width="160" Height="Auto"
                    Orientation="Vertical" Visibility="{Binding MenuVisibility}"
                    Canvas.Right="3" Canvas.Top="36">
            <Button Content="Logout" Command="{Binding LogoutCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
        </StackPanel>
    </Canvas>
</UserControl>
