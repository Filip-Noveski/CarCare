<UserControl x:Class="CarCare.UserInterface.Components.SessionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components"
             mc:Ignorable="d" 
             d:DesignHeight="200" d:DesignWidth="200">
    <Canvas>
        <Grid Width="36" Height="36" Canvas.Right="0" Canvas.Top="0">
            <Grid.Resources>
                <SolidColorBrush x:Key="HoverBrush" Color="#00000000"/>
            </Grid.Resources>

            <Path Width="36" Height="36" Visibility="{Binding MenuVisibility}"
                  Canvas.Right="0" Canvas.Top="0" Fill="{DynamicResource Control.Background}"
                  Data="M-18,36 C-8.059,36, 0,27.941, 0,18
                        C0,8.059, 8.059,0, 18,0
                        C27.941,0, 36,8.059, 36,18 L36,36" />

            <Ellipse x:Name="AvatarSurroundHover" Width="36" Height="36"
                     Fill="{StaticResource HoverBrush}"/>

            <Ellipse x:Name="AvatarImage" Width="30" Height="30">
                <Ellipse.Fill>
                    <ImageBrush ImageSource="{Binding User.Avatar}" Stretch="UniformToFill" />
                </Ellipse.Fill>
            </Ellipse>

            <Button Visibility="Visible" Width="30" Height="30"
                    Canvas.Right="3" Canvas.Top="3"
                    Command="{Binding ToggleMenuCommand}"
                    Opacity="0">
                <Button.Triggers>
                    <EventTrigger RoutedEvent="MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="AvatarSurroundHover"
                                                Storyboard.TargetProperty="Fill.Color"
                                                To="{DynamicResource Control.Border.Colour}" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="AvatarSurroundHover"
                                                Storyboard.TargetProperty="Fill.Color"
                                                To="#00000000" Duration="0:0:0.25"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <Border Background="{DynamicResource Control.Background}"
                BorderThickness="0" Canvas.Right="0" Canvas.Top="36"
                CornerRadius="6,0,6,6">
            <StackPanel Width="160" Height="Auto" Margin="3"
                        Orientation="Vertical" Visibility="{Binding MenuVisibility}">
                <Button Style="{StaticResource IconButton}" Command="{Binding LogoutCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <TextBlock Style="{StaticResource Default}">Log out</TextBlock>
                </Button>
            </StackPanel>
        </Border>
    </Canvas>
</UserControl>
