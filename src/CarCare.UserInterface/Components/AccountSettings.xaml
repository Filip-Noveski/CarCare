<UserControl x:Class="CarCare.UserInterface.Components.AccountSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components"
             xmlns:converters="clr-namespace:CarCare.Processing.Converters;assembly=CarCare.Processing"
             xmlns:controls="clr-namespace:CarCare.UserInterface.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters:UpdatePasswordArgsConverter x:Key="UpdatePasswordArgsConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Orientation="Vertical">
            <Border BorderBrush="{StaticResource Shared.Accent}"
                    BorderThickness="0,0,0,2" Padding="0,6,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource HeadingMedium}"
                           Text="Username" Grid.Row="0" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*" />
                            <ColumnDefinition Width="0.4*" />
                        </Grid.ColumnDefinitions>
                    
                        <controls:TextBoxControl Heading="Username" Text="{Binding Username, Mode=TwoWay}" Margin="6"
                                                 Grid.Column="0"/>
                        <Button Content="Set Username" Command="{Binding UpdateUsernameCommand}" Margin="6"
                                Grid.Column="1"/>
                    </Grid>
                    <TextBlock Style="{StaticResource Error}"
                           Text="{Binding UsernameChangeError}" Grid.Row="3" />
                    <TextBlock Style="{StaticResource Default}"
                           Text="{Binding UsernameChangeSuccess}" Grid.Row="3" />
                </Grid>
            </Border>

            <Border BorderBrush="{StaticResource Shared.Accent}"
                    BorderThickness="0,0,0,2" Padding="0,6,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource HeadingMedium}"
                           Text="Password" Grid.Row="0" />
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.6*" />
                            <ColumnDefinition Width="0.4*" />
                        </Grid.ColumnDefinitions>
                    
                        <controls:PasswordBoxControl x:Name="OldPasswordBox" Heading="Old Password" Margin="6"
                                                     Grid.Row="0" Grid.Column="0" />
                        <controls:PasswordBoxControl x:Name="NewPasswordBox" Heading="New Password" Margin="6" 
                                                     Grid.Row="1" Grid.Column="0" />
                        <controls:PasswordBoxControl x:Name="ConfPasswordBox" Heading="Confirm New Password" Margin="6" 
                                                     Grid.Row="2" Grid.Column="0" />
                    
                        <Button Content="Set Password" Command="{Binding UpdatePasswordCommand}"
                                Grid.Row="2" Grid.Column="1" Margin="6">
                            <Button.CommandParameter>
                                <MultiBinding Converter="{StaticResource UpdatePasswordArgsConverter}">
                                    <Binding Path="InnerPasswordBox" ElementName="OldPasswordBox"/>
                                    <Binding Path="InnerPasswordBox" ElementName="NewPasswordBox"/>
                                    <Binding Path="InnerPasswordBox" ElementName="ConfPasswordBox"/>
                                </MultiBinding>
                            </Button.CommandParameter>
                        </Button>
                        <TextBlock Style="{StaticResource Error}"
                           Text="{Binding PasswordChangeError}" Grid.Row="4" />
                        <TextBlock Style="{StaticResource Default}"
                           Text="{Binding PasswordChangeSuccess}" Grid.Row="4" />
                    </Grid>
                </Grid>
            </Border>


            <Border BorderBrush="{StaticResource Shared.Accent}"
                    BorderThickness="0,0,0,2" Padding="0,6,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.6*"/>
                        <ColumnDefinition Width="0.4*"/>
                    </Grid.ColumnDefinitions>
                
                    <Ellipse Width="80" Height="80" Margin="6"
                             Grid.Row="0" Grid.Column="0">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Center">
                        <Button Width="110" Height="45" Command="{Binding ChooseAvatarCommand}" Margin="6">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Change Avatar</TextBlock>
                        </Button>
                        
                        <Button Width="110" Height="45" Command="{Binding DeleteAvatarCommand}" Margin="6">
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center">Delete Avatar</TextBlock>
                        </Button>
                    </StackPanel>

                    <Button Content="Set Avatar" Command="{Binding UpdateAvatarCommand}"
                            Grid.Row="1"  Grid.Column="1" Margin="6"/>
                    
                    <TextBlock Style="{StaticResource Default}"
                               Text="{Binding AvatarChangeSuccess}" Grid.Row="2" Grid.Column="0" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
