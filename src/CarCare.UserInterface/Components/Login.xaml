<UserControl x:Class="CarCare.UserInterface.Components.Login"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components" 
             xmlns:models="clr-namespace:CarCare.Processing.Models;assembly=CarCare.Processing" 
             xmlns:converters="clr-namespace:CarCare.Processing.Converters;assembly=CarCare.Processing" 
             xmlns:controls="clr-namespace:CarCare.UserInterface.Controls"
             mc:Ignorable="d"
             Loaded="Initialise"
             d:DesignHeight="275" d:DesignWidth="400">
    <UserControl.Resources>
        <converters:AuthenticationArgsConverter x:Key="AuthenticationArgsConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.7*" />
            <RowDefinition Height="0.3*" />
        </Grid.RowDefinitions>

        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                      Grid.Row="0">
            <ScrollViewer.RenderTransform>
                <TranslateTransform x:Name="AccountsTransform" X="0" />
            </ScrollViewer.RenderTransform>
            <Grid>
                <Grid HorizontalAlignment="Center">
                    <ItemsControl ItemsSource="{Binding Users}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:UserLoginCard SelectUserCommand="{Binding DataContext.SelectUserCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*" />
                <ColumnDefinition Width="0.6*" />
            </Grid.ColumnDefinitions>
            <Grid.RenderTransform>
                <TranslateTransform x:Name="CredentialsTransform" X="400" />
            </Grid.RenderTransform>
            
            <StackPanel Orientation="Vertical" VerticalAlignment="Top"
                        Margin="0,0,20,0" Grid.Column="0">
                <Button Style="{StaticResource IconButton}" Command="{Binding ReturnToUsersListCommand}" 
                        Width="40" Height="30"
                        HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                    <Path Width="30" Height="20" Stroke="{DynamicResource Shared.Accent}" StrokeThickness="2"
                          Data="M5,10 L25,10 M10,5L5,10L10,15" />
                </Button>
                <Ellipse Width="60" Height="60" Margin="2">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Style="{StaticResource HeadingMedium}" Text="{Binding Username}" Margin="2"
                           TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>

            <Grid Grid.Column="1">
                <controls:PasswordBoxControl Heading="Password" x:Name="PasswordBox" 
                                             Margin="6" VerticalAlignment="Center" />
                <StackPanel Orientation="Vertical" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource Default}"
                               Foreground="{StaticResource Shared.Accent}"
                               Text="{Binding Error}" />
                    <Button Command="{Binding LoginCommand}"
                            Width="80" Height="30" Margin="6">
                        <Button.CommandParameter>
                            <MultiBinding Converter="{StaticResource AuthenticationArgsConverter}">
                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type Window}}"/>
                                <Binding Path="InnerPasswordBox" ElementName="PasswordBox"/>
                            </MultiBinding>
                        </Button.CommandParameter>
                        Log in
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Default}"
                           TextAlignment="Center" Margin="5" Width="200">
                    Don't have an account?
                </TextBlock>
                <Button Width="80" Margin="5" Height="30"
                        Command="{Binding RegisterCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}">
                    Register
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
