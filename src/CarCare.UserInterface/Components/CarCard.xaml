<UserControl x:Class="CarCare.UserInterface.Components.CarCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Components"
             mc:Ignorable="d">
    <Border BorderBrush="{DynamicResource Shared.Accent}"
            BorderThickness="1"
            CornerRadius="6"
            Height="144"
            Margin="0,4,8,4"
            Cursor="Hand">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Card.Background}" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource Card.Hover.Background}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="256" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.Column="0" RadiusX="5" RadiusY="5">
                <Rectangle.Fill>
                    <ImageBrush ImageSource="{Binding Image}" Stretch="UniformToFill"/>
                </Rectangle.Fill>
            </Rectangle>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Style="{StaticResource HeadingMedium}"
                           Text="{Binding ModelYear}" />
                <TextBlock Style="{StaticResource HeadingMedium}"
                           Text="{Binding Manufacturer}" />
                <TextBlock Style="{StaticResource HeadingMedium}"
                           Text="{Binding Model}" />
                <TextBlock Style="{StaticResource HeadingMedium}"
                           Text="{Binding Specification}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
