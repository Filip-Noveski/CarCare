<UserControl x:Class="CarCare.UserInterface.Controls.TextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CarCare.UserInterface.Controls"
             mc:Ignorable="d">

    <Border Style="{StaticResource InputControlBorder}">
        <StackPanel Orientation="Vertical" Margin="6">
            <TextBlock Style="{StaticResource InputControlHeading}" 
                       Text="{Binding Heading, RelativeSource={RelativeSource AncestorType={x:Type local:TextBoxControl}}}" />
            <TextBox Style="{StaticResource InputControlTextBox}"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType={x:Type local:TextBoxControl}}, Mode=TwoWay}" />
        </StackPanel>
    </Border>
</UserControl>
