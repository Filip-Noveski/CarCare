<Window x:Class="CarCare.UserInterface.Windows.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarCare.UserInterface.Windows" 
        xmlns:controls="clr-namespace:CarCare.UserInterface.Controls"
        mc:Ignorable="d"
        WindowState="Maximized"
        WindowStyle="SingleBorderWindow"
        Icon="/CarCare.UserInterface;component/Resources/logo_smaller.ico"
        Title="CarCare" Height="450" Width="800"
        BorderBrush="{DynamicResource Shared.Accent}"
        BorderThickness="1"
        StateChanged="WindowStateChanged">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="30"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid x:Name="ContentGrid" Margin="7">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{DynamicResource Pane.Background}" Panel.ZIndex="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.5*"/>
                    <ColumnDefinition Width="0.5*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="{DynamicResource TitleBarLogo}"
                       Height="18" HorizontalAlignment="Left" Margin="6"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            WindowChrome.IsHitTestVisibleInChrome="True"
                            ClipToBounds="False">

                    <Grid x:Name="SessionControlContainer" Width="40" Height="24" Margin="3"
                          ClipToBounds="False">
                    </Grid>
                    
                    <Button Style="{DynamicResource WindowControlButton}" 
                            Content="&#x1f5d5;" Command="{Binding MinimiseCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                    
                    <Button Style="{DynamicResource WindowControlButton}" 
                            Content="{Binding MaximiseButtonChar}" Command="{Binding ToggleMaximiseCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

                    <Button Style="{DynamicResource WindowCloseButton}" 
                            Content="&#x1f5d9;" Command="{Binding CloseCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
                </StackPanel>
            </Grid>

            <Rectangle Fill="{DynamicResource Pane.Background}" Grid.Row="1"/>

            <Grid x:Name="MainGrid" Background="{DynamicResource Pane.Background}" Grid.Row="2">
                <TabControl Style="{StaticResource VerticalStackTabControl}">
                    <TabItem Style="{StaticResource VerticalStackTabItem}">
                        <TabItem.Triggers>
                            <EventTrigger RoutedEvent="StackPanel.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MyCarsFlash"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.3" />
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.6" />
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.9" />
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.2" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MyCarsHeadlights"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.2" />
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:1.8" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="StackPanel.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="MyCarsHeadlights"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TabItem.Triggers>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Grid Margin="8,0,14,0" Width="20" Height="20" ClipToBounds="False">
                                    <Image Source="{StaticResource SmallLogo}"
                                           Width="36" Height="36" Margin="-8"/>
                                    <Image x:Name="MyCarsFlash" Source="{StaticResource SmallLogoFlash}" 
                                           Width="36" Height="36" Margin="-8" Opacity="0" />
                                    <Image x:Name="MyCarsHeadlights" Source="{StaticResource SmallLogoHeadlight}"
                                           Width="36" Height="36" Margin="-8" Opacity="0" />
                                </Grid>
                                <TextBlock>My Cars</TextBlock>
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>

                    <TabItem Style="{StaticResource VerticalStackTabItem}">
                        <TabItem.Triggers>
                            <EventTrigger RoutedEvent="StackPanel.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FinancialBreakdownGold"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.2" />
                                            <LinearDoubleKeyFrame Value="0.5" KeyTime="0:0:0.5" />
                                            <LinearDoubleKeyFrame Value="0.85" KeyTime="0:0:0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="StackPanel.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="FinancialBreakdownGold"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.6" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TabItem.Triggers>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Grid Margin="8,0,14,0" Width="20" Height="20" ClipToBounds="False">
                                    <Image Source="{StaticResource Finance}"
                                           Width="20" Height="20" Margin="0"/>
                                    <Image x:Name="FinancialBreakdownGold" Source="{StaticResource FinanceGold}" 
                                           Width="20" Height="20" Margin="0" Opacity="0" />
                                </Grid>
                                <TextBlock>Financial Breakdown</TextBlock>
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>

                    <TabItem Style="{StaticResource VerticalStackTabItem}">
                        <TabItem.Triggers>
                            <EventTrigger RoutedEvent="StackPanel.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GalleryColour"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.35" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GallerySun"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.35" />
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.7" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="StackPanel.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GalleryColour"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.5" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="GallerySun"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.1" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TabItem.Triggers>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Grid Margin="8,0,14,0" Width="20" Height="20" ClipToBounds="False">
                                    <Image Source="{StaticResource Gallery}"
                                           Width="32" Height="32" Margin="-6"/>
                                    <Image x:Name="GalleryColour" Source="{StaticResource GalleryColour}" 
                                           Width="32" Height="32" Margin="-6" Opacity="0" />
                                    <Image x:Name="GallerySun" Source="{StaticResource GallerySun}" 
                                           Width="32" Height="32" Margin="-6" Opacity="0" />
                                </Grid>
                                <TextBlock>Gallery</TextBlock>
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>

                    <TabItem Style="{StaticResource VerticalStackTabItem}">
                        <TabItem.Triggers>
                            <EventTrigger RoutedEvent="StackPanel.MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TripBaseColour"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TripPinColour"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="1" KeyTime="0:0:0.25" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TripPinRotation"
                                                                       Storyboard.TargetProperty="Angle">
                                            <LinearDoubleKeyFrame Value="-30" KeyTime="0:0:0.15" />
                                            <LinearDoubleKeyFrame Value="50" KeyTime="0:0:0.45" />
                                            <LinearDoubleKeyFrame Value="10" KeyTime="0:0:0.75" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="StackPanel.MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TripBaseColour"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TripPinColour"
                                                                       Storyboard.TargetProperty="Opacity">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TripPinRotation"
                                                                       Storyboard.TargetProperty="Angle">
                                            <LinearDoubleKeyFrame Value="0" KeyTime="0:0:0.15" />
                                        </DoubleAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TabItem.Triggers>
                        <TabItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Grid Margin="8,0,14,0" Width="20" Height="20" ClipToBounds="False">
                                    <Image Source="{StaticResource TripBase}"
                                           Width="36" Height="36" Margin="-4,-10,-4,-10"/>
                                    <Image x:Name="TripBaseColour" Source="{StaticResource TripBaseColour}" 
                                           Width="36" Height="36" Margin="-4,-10,-4,-10" Opacity="0" />
                                    <Grid Margin="-4,-10,-4,-10">
                                        <Grid Margin="18">
                                            <Grid.RenderTransform>
                                                <RotateTransform x:Name="TripPinRotation" Angle="0" />
                                            </Grid.RenderTransform>
                                            <Grid Margin="-18">
                                                <Image Source="{StaticResource TripPin}"
                                                       Width="36" Height="36"/>
                                                <Image x:Name="TripPinColour" Source="{StaticResource TripPinColour}" 
                                                       Width="36" Height="36" Opacity="0"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                                <TextBlock>Trips / Events</TextBlock>
                            </StackPanel>
                        </TabItem.Header>
                    </TabItem>
                </TabControl>

                <Button Style="{StaticResource IconButton}" Width="90" Height="32"
                        VerticalAlignment="Bottom" HorizontalAlignment="Left" Panel.ZIndex="2"
                        Margin="12" HorizontalContentAlignment="Left" VerticalContentAlignment="Top">
                    <Button.Resources>
                        <Storyboard x:Key="RotateCog">
                            <DoubleAnimation Storyboard.TargetName="CogRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="90" Duration="0:0:0:0.5" FillBehavior="HoldEnd"/>
                        </Storyboard>
                        
                        <Storyboard x:Key="ResetCog">
                            <DoubleAnimation Storyboard.TargetName="CogRotation"
                                             Storyboard.TargetProperty="Angle"
                                             To="0" Duration="0:0:0:0.5" FillBehavior="HoldEnd"/>
                        </Storyboard>
                    </Button.Resources>

                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource RotateCog}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource ResetCog}" />
                        </EventTrigger>
                    </Button.Triggers>

                    <Canvas>
                        <Grid Canvas.Left="16" Canvas.Top="16">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="0.67" ScaleY="0.67"/>
                                    <TranslateTransform X="-16" Y="-16"/>
                                    <RotateTransform x:Name="CogRotation" Angle="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>
                            
                            <controls:SettingsCog />
                        </Grid>
                        
                        <TextBlock Style="{StaticResource Default}" FontSize="14"
                                   Canvas.Left="24" Canvas.Top="3">
                            Settings
                        </TextBlock>
                    </Canvas>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Window>
