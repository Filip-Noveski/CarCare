<Window x:Class="CarCare.UserInterface.Windows.Splash"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarCare.UserInterface.Windows"
        mc:Ignorable="d"
        Icon="/CarCare.UserInterface;component/Resources/logo_smaller.ico"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        Title="CarCare" Height="325" Width="500"
        WindowStartupLocation="CenterScreen">
    <Canvas>
        <Image Source="/CarCare.UserInterface;component/Resources/splash_background.png"
               Width="500" Height="250"
               Canvas.Left="0" Canvas.Top="0" />

        <Image Source="/CarCare.UserInterface;component/Resources/logo_fullsize_backgrnd.png"
               Width="250" Height="250" 
               Canvas.Left="245" Canvas.Top="85" />

        <Image Source="/CarCare.UserInterface;component/Resources/Script.png"
               Width="150" Height="50"
               Canvas.Left="20" Canvas.Top="40" />

        <TextBlock Text="{Binding OperationText}" Foreground="#FFFFFF"
                   Canvas.Left="8" Canvas.Top="225"/>
    </Canvas>
</Window>
