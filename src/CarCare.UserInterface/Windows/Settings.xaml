<Window x:Class="CarCare.UserInterface.Windows.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CarCare.UserInterface.Windows" 
        xmlns:converters="clr-namespace:CarCare.Processing.Converters;assembly=CarCare.Processing"
        mc:Ignorable="d"
        WindowStyle="SingleBorderWindow"
        Title="Settings - CarCare" Height="450" Width="800"
        ResizeMode="CanMinimize"
        Background="{DynamicResource Pane.Background}"
        BorderBrush="{DynamicResource Shared.Accent}"
        BorderThickness="1"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Thickness x:Key="TabItemPadding">12,8,48,8</Thickness>
        <converters:EnumToIntConverter x:Key="EnumToIntConverter" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="30"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{DynamicResource Pane.Background}" Panel.ZIndex="100">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*"/>
                <ColumnDefinition Width="0.5*"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="{DynamicResource TitleBarLogo}"
                   Height="18" HorizontalAlignment="Left" Margin="6"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        ClipToBounds="False">

                <Grid x:Name="SessionControlContainer" Width="40" Height="24" Margin="3"
                      ClipToBounds="False">
                </Grid>

                <Button Style="{DynamicResource WindowControlButton}" 
                        Content="&#x1f5d5;" Command="{Binding MinimiseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>

                <Button Style="{DynamicResource WindowCloseButton}" 
                        Content="&#x1f5d9;" Command="{Binding CloseCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"/>
            </StackPanel>
        </Grid>

        <TabControl Style="{StaticResource VerticalStackTabControl}"
                    Grid.Row="1"
                    SelectedIndex="{Binding Tab, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}">
            <TabItem x:Name="AccountSettingsTab"
                     Style="{StaticResource VerticalStackTabItem}"
                     Header="Account Settings"
                     Padding="{StaticResource TabItemPadding}">
                
            </TabItem>

            <TabItem x:Name="AppSettingsTab"
                     Style="{StaticResource VerticalStackTabItem}"
                     Header="Application Settings"
                     Padding="{StaticResource TabItemPadding}">
                
            </TabItem>
        </TabControl>
    </Grid>
</Window>
