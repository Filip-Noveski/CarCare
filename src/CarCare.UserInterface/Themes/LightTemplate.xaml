<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BitmapImage x:Key="TitleBarLogo" UriSource="/CarCare.UserInterface;component/Resources/logo_and_script_light.png" />
    <BitmapImage x:Key="SmallLogo" UriSource="/CarCare.UserInterface;component/Resources/logo_smaller_light.png" />
    <BitmapImage x:Key="SmallLogoFlash" UriSource="/CarCare.UserInterface;component/Resources/logo_smaller_flash.png" />
    <BitmapImage x:Key="SmallLogoHeadlight" UriSource="/CarCare.UserInterface;component/Resources/logo_smaller_headlight.png" />

    <BitmapImage x:Key="Finance" UriSource="/CarCare.UserInterface;component/Resources/finance_light.png" />
    <BitmapImage x:Key="FinanceGold" UriSource="/CarCare.UserInterface;component/Resources/finance_gold.png" />

    <BitmapImage x:Key="Gallery" UriSource="/CarCare.UserInterface;component/Resources/gallery_light.png" />
    <BitmapImage x:Key="GalleryColour" UriSource="/CarCare.UserInterface;component/Resources/gallery_colour.png" />
    <BitmapImage x:Key="GallerySun" UriSource="/CarCare.UserInterface;component/Resources/gallery_sun.png" />

    <BitmapImage x:Key="TripBase" UriSource="/CarCare.UserInterface;component/Resources/trip_base_light.png" />
    <BitmapImage x:Key="TripPin" UriSource="/CarCare.UserInterface;component/Resources/trip_pin_light.png" />
    <BitmapImage x:Key="TripBaseColour" UriSource="/CarCare.UserInterface;component/Resources/trip_base_colour.png" />
    <BitmapImage x:Key="TripPinColour" UriSource="/CarCare.UserInterface;component/Resources/trip_pin_colour.png" />

    <SolidColorBrush x:Key="Shared.Accent" Color="#FFB61111" />
    <SolidColorBrush x:Key="Shared.Accent.SemiTransparent" Color="#22B61111" />

    <SolidColorBrush x:Key="Window.Background" Color="#FFE8E8E8" />

    <SolidColorBrush x:Key="Pane.Border" Color="#FF333333" />
    <SolidColorBrush x:Key="Pane.Background" Color="#FFE8E8E8" />

    <SolidColorBrush x:Key="Card.Background" Color="#00000000" />
    <SolidColorBrush x:Key="Card.Hover.Background" Color="#30000000" />

    <LinearGradientBrush x:Key="TabPanel.Background" StartPoint="0, 0" EndPoint="1, 1">
        <GradientStop Color="#FFF0FAFF" Offset="0" />
        <GradientStop Color="#FFC0D8EA" Offset="0.5" />
        <GradientStop Color="#FFD0E6F0" Offset="0.95" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabItem.Hover.Background" StartPoint="0, 0" EndPoint="1, 1">
        <GradientStop Color="#FFC0D8EA" Offset="0" />
        <GradientStop Color="#FFB0B8BF" Offset="0.5" />
        <GradientStop Color="#FFD0E6F0" Offset="0.95" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabItem.Selected.Background" StartPoint="0, 0" EndPoint="1, 1">
        <GradientStop Color="#FFC0D8EA" Offset="0" />
        <GradientStop Color="#FFB8C0CF" Offset="0.5" />
        <GradientStop Color="#FFC8D6E8" Offset="0.95" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#FFEEEEEE" />

    <SolidColorBrush x:Key="Text.Colour" Color="#FF000000" />
    <SolidColorBrush x:Key="Text.Error.Colour" Color="#FFAA0800" />
    <SolidColorBrush x:Key="Text.Colour.Disabled" Color="#88000000" />

    <SolidColorBrush x:Key="Control.Background" Color="#FFD0D0D0" />
    <Color x:Key="Control.Border.Colour">#FF3A3A3A</Color>
    <SolidColorBrush x:Key="Control.Border" Color="{DynamicResource Control.Border.Colour}" />
    <SolidColorBrush x:Key="Control.Selected.Background" Color="#22777777" />
    <SolidColorBrush x:Key="Control.Hover.Background" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Control.Hover.Border" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Control.Pressed.Background" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Control.Pressed.Border" Color="#FF101010" />
    <SolidColorBrush x:Key="Control.Focused.Background" Color="#FFEAEAEA" />
    <SolidColorBrush x:Key="Control.Focused.Border" Color="#FF181818" />
    <SolidColorBrush x:Key="Control.Disabled.Background" Color="#FFB0B0B0" />
    <SolidColorBrush x:Key="Control.Disabled.Foreground" Color="#FF686868" />
    <SolidColorBrush x:Key="Control.Disabled.Border" Color="#FF4A4A4A" />

    <SolidColorBrush x:Key="WindowControlButton.Background" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Border" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Hover.Background" Color="#44000000" />
    <SolidColorBrush x:Key="WindowControlButton.Hover.Border" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Pressed.Background" Color="#88000000" />
    <SolidColorBrush x:Key="WindowControlButton.Pressed.Border" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="WindowControlButton.Disabled.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="WindowControlButton.Disabled.Foreground" Color="#88DDDDDD"/>

    <SolidColorBrush x:Key="Separator.Background" Color="#FF989898" />

</ResourceDictionary>