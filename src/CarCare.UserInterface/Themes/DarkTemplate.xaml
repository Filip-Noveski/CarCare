<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <BitmapImage x:Key="TitleBarLogo" UriSource="/CarCare.UserInterface;component/Resources/logo_and_script_dark.png" />

    <SolidColorBrush x:Key="Shared.Accent" Color="#FFFF2020" />
    <SolidColorBrush x:Key="Shared.Accent.SemiTransparent" Color="#22FF2020" />

    <SolidColorBrush x:Key="Window.Background" Color="#FF181818" />

    <SolidColorBrush x:Key="Pane.Border" Color="#FF888888" />
    <SolidColorBrush x:Key="Pane.Background" Color="#FF181818" />

    <SolidColorBrush x:Key="Card.Background" Color="#00AAAAAA" />
    <SolidColorBrush x:Key="Card.Hover.Background" Color="#30AAAAAA" />

    <LinearGradientBrush x:Key="TabPanel.Background" StartPoint="0, 0" EndPoint="1, 1">
        <GradientStop Color="#FF060606" Offset="0" />
        <GradientStop Color="#FF121212" Offset="0.5" />
        <GradientStop Color="#FF0A0A0A" Offset="0.95" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabItem.Hover.Background" StartPoint="0, 0" EndPoint="1, 1">
        <GradientStop Color="#FF121212" Offset="0" />
        <GradientStop Color="#FF202020" Offset="0.5" />
        <GradientStop Color="#FF1A1A1A" Offset="0.95" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TabItem.Selected.Background" StartPoint="0, 0" EndPoint="1, 1">
        <GradientStop Color="#FF121212" Offset="0" />
        <GradientStop Color="#FF1B1B1B" Offset="0.5" />
        <GradientStop Color="#FF191919" Offset="0.95" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="TabItem.Disabled.Background" Color="#FF242424" />

    <SolidColorBrush x:Key="Text.Colour" Color="#FFBBBBBB" />
    <SolidColorBrush x:Key="Text.Error.Colour" Color="#FFFF2810" />
    <SolidColorBrush x:Key="Text.Colour.Disabled" Color="#88BBBBBB" />

    <SolidColorBrush x:Key="Control.Background" Color="#FF282828" />
    <Color x:Key="Control.Border.Colour">#FF3A3A3A</Color>
    <SolidColorBrush x:Key="Control.Border" Color="{DynamicResource Control.Border.Colour}" />
    <SolidColorBrush x:Key="Control.Selected.Background" Color="#22777777" />
    <SolidColorBrush x:Key="Control.Hover.Background" Color="#FF383838" />
    <SolidColorBrush x:Key="Control.Hover.Border" Color="#FF585858" />
    <SolidColorBrush x:Key="Control.Pressed.Background" Color="#FF484848" />
    <SolidColorBrush x:Key="Control.Pressed.Border" Color="#FF686868" />
    <SolidColorBrush x:Key="Control.Focused.Background" Color="#FF484848" />
    <SolidColorBrush x:Key="Control.Focused.Border" Color="#FF686868" />
    <SolidColorBrush x:Key="Control.Disabled.Background" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Control.Disabled.Foreground" Color="#FF686868" />
    <SolidColorBrush x:Key="Control.Disabled.Border" Color="#FF242424" />

    <SolidColorBrush x:Key="WindowControlButton.Background" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Border" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Hover.Background" Color="#44FFFFFF" />
    <SolidColorBrush x:Key="WindowControlButton.Hover.Border" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Pressed.Background" Color="#88FFFFFF" />
    <SolidColorBrush x:Key="WindowControlButton.Pressed.Border" Color="Transparent" />
    <SolidColorBrush x:Key="WindowControlButton.Disabled.Background" Color="Transparent"/>
    <SolidColorBrush x:Key="WindowControlButton.Disabled.Border" Color="Transparent"/>
    <SolidColorBrush x:Key="WindowControlButton.Disabled.Foreground" Color="#88DDDDDD"/>

    <SolidColorBrush x:Key="Separator.Background" Color="#FF383838" />

</ResourceDictionary>